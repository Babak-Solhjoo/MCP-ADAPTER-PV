# ============================================================================================
# SECURITY POLICY  (choose with `mcp-adapter-setup`, or edit here and restart the server)
# ============================================================================================
# local   = the server may only listen on 127.0.0.1/localhost; other --host values are refused
#           and requests whose Host header is not localhost are rejected. DENY any firewall prompt.
# network = the server may listen on other interfaces (only when started with --host <address>).
MCP_ADAPTER_NETWORK_MODE=local

# Tools that call external web APIs (search_docs_online via Tavily, mathematica_wolfram_alpha)
# are only registered when this is true. Everything else works fully offline.
MCP_ADAPTER_ALLOW_INTERNET=false

# network mode only: comma-separated Host header allow-list, e.g. 192.168.1.20:8000,workstation:*
MCP_ADAPTER_ALLOWED_HOSTS=
# Bearer token for the HTTP transports (streamable-http, sse). REQUIRED for every HTTP transport, local mode
# included; mcp-adapter-setup and the UI's MCP endpoint generate one. Clients send 'Authorization: Bearer <token>'.
# stdio (the default transport) needs no token.
# MCP_ADAPTER_AUTH_TOKEN=

# Tavily API key (used only when MCP_ADAPTER_ALLOW_INTERNET=true)
TAVILY_API=

# ============================================================================================
# ADAPTER MODE
# ============================================================================================
# By default automation tools are registered only for applications that were detected at start-up,
# so agents never see tools they cannot use. Set to true to register every tool regardless (each call
# then returns ok=false with a hint when the application is missing).
MCP_ADAPTER_EXPOSE_UNAVAILABLE=false

# ============================================================================================
# PER-APPLICATION SWITCHES (edit here or with the configuration UI: mcp-adapter-ui)
# false hides all automation tools of that application; the catalog stays available.
# ============================================================================================
# MCP_ADAPTER_ENABLE_MATLAB=true
# MCP_ADAPTER_ENABLE_SIMULINK=true
# MCP_ADAPTER_ENABLE_MATHEMATICA=true
# MCP_ADAPTER_ENABLE_COMSOL=true
# MCP_ADAPTER_ENABLE_PHOTOSHOP=true
# MCP_ADAPTER_ENABLE_ORCAD=true
# MCP_ADAPTER_ENABLE_ALTIUM=true
# MCP_ADAPTER_ENABLE_PROTEUS=true
# MCP_ADAPTER_ENABLE_VIVADO=true
# MCP_ADAPTER_ENABLE_AUTOCAD=true
# MCP_ADAPTER_ENABLE_HFSS=true
# MCP_ADAPTER_ENABLE_DRAWIO=true
# MCP_ADAPTER_ENABLE_FEKO=true
# MCP_ADAPTER_ENABLE_EAGLE=true

# ============================================================================================
# APPLICATION EXECUTABLES (optional). If unset, the adapter searches PATH and the usual
# vendor install folders. Setting one and restarting the server exposes that application's tools.
# ============================================================================================
# MATLAB_EXE=C:\Program Files\MATLAB\R2024b\bin\matlab.exe
# WOLFRAMSCRIPT_EXE=C:\Program Files\Wolfram Research\Mathematica\14.1\wolframscript.exe
# COMSOL_EXE=C:\Program Files\COMSOL\COMSOL62\Multiphysics\bin\win64\comsolbatch.exe
# PHOTOSHOP_EXE=C:\Program Files\Adobe\Adobe Photoshop 2025\Photoshop.exe
# ORCAD_CAPTURE_EXE=C:\Cadence\SPB_23.1\tools\bin\capture.exe
# PSPICE_EXE=C:\Cadence\SPB_23.1\tools\bin\pspice.exe
# ALTIUM_EXE=C:\Program Files\Altium\AD24\X2.EXE
# PROTEUS_EXE=C:\Program Files (x86)\Labcenter Electronics\Proteus 8 Professional\BIN\PDS.EXE
# VIVADO_EXE=C:\Xilinx\Vivado\2024.2\bin\vivado.bat
# VITIS_HLS_EXE=C:\Xilinx\Vitis_HLS\2024.2\bin\vitis_hls.bat
# AUTOCAD_CORE_CONSOLE_EXE=C:\Program Files\Autodesk\AutoCAD 2025\accoreconsole.exe
# ANSYS_EDT_EXE=C:\Program Files\AnsysEM\v251\Win64\ansysedt.exe
# DRAWIO_EXE=C:\Program Files\draw.io\draw.io.exe
# FEKO_EXE=C:\Program Files\Altair\2025.1\feko\bin\runfeko.exe
# EAGLE_EXE=C:\Program Files\EAGLE 9.6.0\eaglecon.exe

# Release-specific command-line overrides
# PSPICE_ARGS=-r
# ORCAD_CAPTURE_TCL_CMD={exe} -tcl {script}
# ALTIUM_SCRIPT_ARGS=-RScriptFile:{script} -RProcName:{proc}
# PHOTOSHOP_APP_NAME=Adobe Photoshop 2025

# Default timeout (seconds) for launching external software, and where generated scripts go
# MCP_ADAPTER_TIMEOUT=600
# MCP_ADAPTER_OUTPUT_DIR=./outputs
# Optional: folders that set_output_folder may use for task results (separated by ;). Empty = any local folder that
# passes the built-in checks (existing, writable, not a drive root, home, hidden, system, AppData or network folder).
# MCP_ADAPTER_OUTPUT_ROOTS=D:\Projects\PCB;D:\Projects\Simulation

# API keys for the bundled agent runner (mcp-adapter-agent / the workspace UI chats). Keys in this file are never
# passed to the MCP server, the applications or any child process, and are redacted from transcripts.
# ANTHROPIC_API_KEY=

# Agent / chat box settings (written by the configuration UI)
# AGENT_MODEL=claude-opus-5
# AGENT_EFFORT=
# AGENT_MAX_TURNS=40
# AGENT_APPROVE_TOOLS=false
# AGENT_SHOW_THINKING=false
# Default working folder of new UI chats (the UI writes it); per task, the runner passes the folder itself
# AGENT_WORK_DIR=
# Folder and full-access switch for the MCP endpoint the UI starts for external apps. MCP servers never read
# these two keys from .env: they only come from the process that starts the server.
# MCP_ADAPTER_WORK_DIR=
# MCP_ADAPTER_WORK_DIR_ACCESS=false

# OpenAI provider for the agent runner (optional alternative to Anthropic)
# AGENT_PROVIDER=anthropic          # anthropic | openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                  # optional: OpenAI-compatible endpoint (Azure, local gateway); https, or http on localhost
# OPENAI_COMPAT_API_KEY=            # key for that endpoint; OPENAI_API_KEY is only ever sent to api.openai.com
# AGENT_OPENAI_MODEL=gpt-5

# Working-folder access for external apps using the HTTP MCP endpoint (chat UI sets these per chat itself)
# MCP_ADAPTER_WORK_DIR_ACCESS=false
# Local HTTP MCP endpoint for other LLM apps (Settings > MCP server)
# MCP_HTTP_PORT=8766
# MCP_HTTP_AUTOSTART=false
# Where chats are stored (default outputs/chats)
# MCP_ADAPTER_CHATS_DIR=
